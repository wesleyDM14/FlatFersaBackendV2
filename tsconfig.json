{
  "compilerOptions": {
    /* Language and Environment */
    "target": "es2020",
    /* Modules */
    "module": "commonjs",
    "rootDir": "./src",
    "typeRoots": [
      "./src/@types"
    ],
    /* Emit */
    "outDir": "./dist",
    /* Interop Constraints */
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    /* Type Checking */
    "strict": false,
    "skipLibCheck": true
  },
  "include": [
    "src/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}